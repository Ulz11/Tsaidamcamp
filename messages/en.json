    "faq": {
      "eyebrow": "Questions",
      "heading": "Frequently<br/><em>Asked</em>",
      "sub": "Everything you need to know before your stay. Can't find an answer? Write to us directly.",
      "contact": "Contact Us",
      "q1": {
        "q": "What is the best time to visit?",
        "a": "The camp is open from June through September. July and August offer the warmest weather and the most vibrant steppe landscape, while June and September bring cooler temperatures and fewer visitors — ideal for a more private retreat."
      },
      "q2": {
        "q": "How do I get to Tsaidam?",
        "a": "The camp is located in Bayan soum, Arkhangai Province — approximately 6 hours by vehicle from Ulaanbaatar. We offer airport transfer services upon request. The nearest town is Tsetserleg, about 90 km away."
      },
      "q3": {
        "q": "Is there Wi-Fi or phone signal?",
        "a": "Tsaidam is intentionally off the grid — part of the experience. There is no Wi-Fi, and mobile signal is minimal. Emergency satellite communication is available at the camp office. We encourage guests to fully disconnect."
      },
      "q4": {
        "q": "What is included in the stay?",
        "a": "All stays include three daily meals (breakfast, lunch, dinner) prepared by our on-site chef, one guided activity of your choice, and access to all shared camp facilities. Premium activities such as eagle hunting or multi-day treks are priced separately."
      },
      "q5": {
        "q": "What should I pack?",
        "a": "Layers are key — mornings and evenings can be cold even in summer. We recommend sturdy walking shoes, sunscreen, a warm jacket, and a camera. Bedding, towels, and basic toiletries are all provided in your ger or cabin."
      }
    },
